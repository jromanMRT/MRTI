# Plantilla para MRTI/server/.env.docker (uso exclusivo del contenedor de
# prueba de core-api, ver docker-compose.core.yml). NO poner valores reales
# en este archivo — está versionado. Copiar a `.env.docker` (ignorado por
# git) y llenar con los mismos valores reales que ya usa server/.env,
# ajustando solo los apuntados abajo.
#
# No usar valores de relleno tipo "changeme": si falta un valor real, dejar
# la línea vacía para que el proceso falle de forma explícita al iniciar
# (JWT_SECRET corto/vacío ya hace que src/config/security.js lance error en
# NODE_ENV=production) en vez de arrancar con un secreto débil conocido.

NODE_ENV=production

# Puerto interno del proceso Node. docker-compose.core.yml publica este mismo
# puerto en 127.0.0.1 del host durante la fase de prueba (no usar 3005 aquí
# mientras PM2 lo esté sirviendo).
PORT=3105

# MySQL sigue en el host (fase 1 de contenerización: sin cambios de base) y
# solo escucha en 127.0.0.1 (bind-address, no se toca). El compose usa
# `network_mode: host` precisamente para que estas URLs de loopback
# resuelvan igual dentro del contenedor que en PM2 — ver el comentario de
# red al inicio de docker-compose.core.yml para las limitaciones que implica.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=

JWT_SECRET=
JWT_EXPIRES_IN=

# MRTI-Obs y MRTI Activos también siguen en PM2 sobre 127.0.0.1 del host.
MRTI_OBS_URL=http://127.0.0.1:3002
MRTI_ASSETS_URL=http://127.0.0.1:3003

ALLOW_PUBLIC_REGISTRATION=false

# Opcional, no documentada previamente en .env.example pero sí leída por
# src/config/security.js. Dejar vacía para heredar las reglas de red
# privada/desarrollo local ya implementadas.
CORS_ORIGIN=
