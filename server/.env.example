# Conexion a MySQL - misma base que usa MRTI Infra en Fase 1 (mrti_infra).
# En Fase 3 esto migrara a una base propia mrti_core.
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=mrti_infra

# Autenticacion - durante la transicion DEBE ser el MISMO valor que
# JWT_SECRET en MRTI-Infra/server/.env, para que los tokens sean
# intercambiables entre ambos procesos. No generar un secreto nuevo aqui.
JWT_SECRET=cambia-este-secreto
JWT_EXPIRES_IN=8h
ALLOW_PUBLIC_REGISTRATION=true

# Servidor
PORT=3005
NODE_ENV=development
