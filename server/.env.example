# Conexion a MySQL - misma base que usa MRTI Infra en Fase 1 (mrti_infra).
# En Fase 3 esto migrara a una base propia mrti_core.
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=mrti_infra

# MRTI-Obs conserva temporalmente el puerto y la base de Infra durante la
# migración. MRTI_INFRA_URL continúa aceptándose como fallback de rollback.
MRTI_OBS_URL=http://127.0.0.1:3002
MRTI_ASSETS_URL=http://127.0.0.1:3003
MRTI_RH_URL=http://127.0.0.1:3004
MRTI_TICKETS_URL=http://127.0.0.1:4000

# Autoservicio de topologia/dispositivos (Fase 3): Core ya no hace SQL
# directo contra las tablas de Infra, las consulta por /api/self/*.
MRTI_INFRA_URL=http://127.0.0.1:3002

# Autenticacion - durante la transicion DEBE ser el MISMO valor que
# JWT_SECRET en MRTI-Infra/server/.env, para que los tokens sean
# intercambiables entre ambos procesos. No generar un secreto nuevo aqui.
JWT_SECRET=cambia-este-secreto
JWT_EXPIRES_IN=8h
ALLOW_PUBLIC_REGISTRATION=true

# Servidor
PORT=3005
NODE_ENV=development
