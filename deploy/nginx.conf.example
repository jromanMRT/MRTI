# Portal MRTI en / y MRTI-Obs en /mrti-obs/.
server {
    listen 80;
    server_name _;

    client_max_body_size 30M;

    # Portal principal.
    root /var/www/mrt/MRTI/MRTI/dist;
    index index.html;

    # API y WebSocket de MRTI-Obs.
    location /socket.io/ {
        proxy_pass http://127.0.0.1:3002;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_read_timeout 3600s;
    }

    # Autenticación e identidad — MRTI Core (Fase 2 de la migración Core/Infra).
    # Debe quedar antes de /api/ porque es el prefijo más específico.
    location /api/auth/ {
        proxy_pass http://127.0.0.1:3005;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Servicios propios del portal (catálogo, auditoría y próximas funciones
    # de composición). Debe quedar antes del catch-all operativo de MRTI-Obs.
    location /api/portal/ {
        proxy_pass http://127.0.0.1:3005;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /api/ {
        proxy_pass http://127.0.0.1:3002;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # API de MRTI Tickets. El prefijo público se elimina antes de enviar
    # la petición al backend, que conserva sus rutas internas bajo /api.
    location /tickets-api/ {
        proxy_pass http://127.0.0.1:4000/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location = /mrti-infra {
        return 301 /mrti-obs/;
    }

    # Compatibilidad para enlaces anteriores; se retirará al confirmar
    # tráfico cero sobre /mrti-infra/.
    location ^~ /mrti-infra/ {
        rewrite ^/mrti-infra/(.*)$ /mrti-obs/$1 permanent;
    }

    location = /mrti-obs {
        return 301 /mrti-obs/;
    }

    # Aplicación canónica de observabilidad.
    location ^~ /mrti-obs/ {
        alias /var/www/mrt/MRTI/MRTI-Infra/dist/;
        try_files $uri $uri/ /mrti-obs/index.html;
    }

    # API de MRTI Activos. Mismo patrón que /tickets-api/.
    location /activos-api/ {
        proxy_pass http://127.0.0.1:3003/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location = /activos {
        return 301 /activos/;
    }

    location ^~ /activos/ {
        alias /var/www/mrt/MRTI/MRTI-Activos/dist/;
        try_files $uri $uri/ /activos/index.html;
    }

    # API de MRTI RH. Mismo patrón que /activos-api/.
    location /rh-api/ {
        proxy_pass http://127.0.0.1:3004/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location = /rh {
        return 301 /rh/;
    }

    location ^~ /rh/ {
        alias /var/www/mrt/MRTI/MRTI-RH/dist/;
        try_files $uri $uri/ /rh/index.html;
    }

    # API de MRTI Legal. Mismo patrón que /rh-api/. Pendiente de activar en
    # el nginx real hasta que exista la base mrti_legal (ver README de
    # MRTI-Legal §Pendientes) -- no descomentar/activar antes de eso.
    location /legal-api/ {
        proxy_pass http://127.0.0.1:3006/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location = /mrti-legal {
        return 301 /mrti-legal/;
    }

    location ^~ /mrti-legal/ {
        alias /var/www/mrt/MRTI/MRTI-Legal/dist/;
        try_files $uri $uri/ /mrti-legal/index.html;
    }

    location = /tickets {
        return 301 /tickets/;
    }

    # El frontend de Tickets corre aislado y solo escucha en localhost.
    location ^~ /tickets/ {
        proxy_pass http://127.0.0.1:4173;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # El Core de agentes conserva su puerto porque sus enlaces y endpoints
    # internos están publicados desde la raíz del servicio Go.
    location = /agent-core {
        return 302 http://$host:8477/;
    }

    location = /agent-core/ {
        return 302 http://$host:8477/;
    }

    # Portal principal. También permite agregar rutas propias en el futuro.
    location / {
        try_files $uri $uri/ /index.html;
    }
}
